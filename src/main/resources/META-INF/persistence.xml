<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="FacturacionPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.EntityId</class>
        <class>org.example.AuditoriaApp</class>
        <class>org.example.Usuario</class>
        <class>org.example.Cliente</class>
        <class>org.example.Contacto</class>
        <class>org.example.Domicilio</class>
        <class>org.example.CondicionIva</class>
        <class>org.example.TipoMoneda</class>
        <class>org.example.PuntoVenta</class>
        <class>org.example.Rubro</class>
        <class>org.example.Marca</class>
        <class>org.example.Articulo</class>
        <class>org.example.ListaPrecio</class>
        <class>org.example.ListaPrecioArticulo</class>
        <class>org.example.FacturaVenta</class>
        <class>org.example.FacturaVentaDetalle</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/facturacion"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="EEJEMPLOO"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

        </properties>

    </persistence-unit>

</persistence>