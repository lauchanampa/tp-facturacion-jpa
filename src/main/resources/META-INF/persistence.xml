<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="FacturacionPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.entidad.EntityId</class>
        <class>org.example.entidad.AuditoriaApp</class>
        <class>org.example.entidad.Usuario</class>
        <class>org.example.entidad.Cliente</class>
        <class>org.example.entidad.Contacto</class>
        <class>org.example.entidad.Domicilio</class>
        <class>org.example.entidad.CondicionIva</class>
        <class>org.example.entidad.TipoMoneda</class>
        <class>org.example.entidad.PuntoVenta</class>
        <class>org.example.entidad.Rubro</class>
        <class>org.example.entidad.Marca</class>
        <class>org.example.entidad.Articulo</class>
        <class>org.example.entidad.ListaPrecio</class>
        <class>org.example.entidad.ListaPrecioArticulo</class>
        <class>org.example.entidad.FacturaVenta</class>
        <class>org.example.entidad.FacturaVentaDetalle</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/facturacion"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="EJEMPLO"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

        </properties>

    </persistence-unit>

</persistence>